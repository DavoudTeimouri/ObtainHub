<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="ObtainHub"
           Language="1033"
           Version="2.0.0"
           Manufacturer="DavoudTeimouri"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of ObtainHub is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="ObtainHub" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="PathEnvironment" />
      <ComponentRef Id="ApplicationShortcut" />
      <!-- GENERATED COMPONENT REFS -->
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ObtainHub" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="ObtainHub" />
      </Directory>
    </Directory>
  </Fragment>

  <!-- CNDL0005: Environment is only legal inside a Fragment, not under Product. -->
  <Fragment>
    <Component Id="PathEnvironment" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567893">
      <Environment Id="AddToPath"
                   Name="PATH"
                   Value="[INSTALLFOLDER]"
                   Action="set"
                   Part="last"
                   Permanent="no"
                   System="no" />
    </Component>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents">
      <Component Id="MainExecutable" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567891" Directory="INSTALLFOLDER">
        <File Id="ohub.exe" Source="dist\ohub\ohub.exe" KeyPath="yes" Checksum="yes" />
      </Component>
      <Component Id="ApplicationShortcut" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567892" Directory="ApplicationProgramsFolder">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="ObtainHub"
                  Target="[INSTALLFOLDER]ohub.exe" />
        <RemoveFolder Id="CleanupApplicationProgramsFolder" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- GENERATED PAYLOAD -->
</Wix>
