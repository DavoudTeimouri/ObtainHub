<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="ObtainHub"
           Language="1033"
           Version="2.0.0"
           Manufacturer="DavoudTeimouri"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of ObtainHub is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="ObtainHub" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="OnedirPayload" />
    </Feature>

    <!-- Add to user PATH -->
    <Property Id="PATH_ACTION" Value="set" />
    <Environment Id="AddToPath"
                 Name="PATH"
                 Value="[INSTALLFOLDER]"
                 Action="set"
                 Part="last"
                 Permanent="no"
                 System="no" />
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ObtainHub" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="ObtainHub" />
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567891">
        <File Id="ohub.exe" Source="dist\ohub\ohub.exe" KeyPath="yes" Checksum="yes" />
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Directory="ApplicationProgramsFolder"
                  Name="ObtainHub"
                  Target="[INSTALLFOLDER]ohub.exe"
                  WorkingDirectory="INSTALLFOLDER" />
      </Component>
    </ComponentGroup>

  </Fragment>

    <!-- GENERATED PAYLOAD: replaced by tools/gen_wix_payload.py at build time. -->

</Wix>
