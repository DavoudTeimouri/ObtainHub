<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="ObtainHub"
           Language="1033"
           Version="2.1.2"
           Manufacturer="DavoudTeimouri"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine"
             Platform="x64" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of ObtainHub is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- The EXE installer writes its uninstall entry to
         HKLM\...\Uninstall\{UpgradeCode}_is1 (Inno appends _is1 to its AppId,
         which is the same GUID). A launch condition on that key stops the two
         installers double-installing into the same folder. -->
    <RegistrySearch Id="InnoUninstallEntrySearch" Root="HKLM"
                    Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}_is1"
                    Format="exists" />
    <Launch Condition="Installed OR NOT InnoUninstallEntrySearch"
            Message="ObtainHub is already installed by ObtainHub-Setup.exe. Uninstall it first, then run this installer. Both installers write to the same folder." />

    <Feature Id="ProductFeature" Title="ObtainHub" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="PathEnvironment" />
      <!-- GENERATED COMPONENT REFS -->
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ObtainHub" />
      </Directory>
    </Directory>
  </Fragment>

  <!-- CNDL0005: Environment is only legal inside a Fragment, not under Product.
       The registry value is the KeyPath; ICE05 rejects a component with none. -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="PathEnvironment" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567893" Win64="yes">
        <Environment Id="AddToPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]\"
                     Action="set"
                     Part="last"
                     Permanent="no"
                     System="no" />
        <RegistryValue Root="HKLM" Key="Software\ObtainHub" Name="PathInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!-- CNDL0062 and CNDL0010 disagree: inside a ComponentGroup a Component must
       not carry @Directory, and outside one it must. Neither rule applies under
       a DirectoryRef, so both Components live here. Same shape the generated
       payload uses. -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567891" Win64="yes">
        <File Id="ohub.exe" Source="dist\ohub\ohub.exe" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <!-- No shortcut component: ohub is a console tool launched from a terminal.
         Leaving an empty ProgramMenuFolder DirectoryRef keeps the Start-menu
         folder out of the Feature; the directory is simply never populated. -->
  </Fragment>

  <!-- GENERATED PAYLOAD -->
</Wix>
