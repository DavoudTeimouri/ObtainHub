<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="ObtainHub"
           Language="1033"
           Version="2.0.0"
           Manufacturer="DavoudTeimouri"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of ObtainHub is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="ObtainHub" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="PathEnvironment" />
      <ComponentRef Id="ApplicationShortcut" />
      <!-- GENERATED COMPONENT REFS -->
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ObtainHub" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="ObtainHub" />
      </Directory>
    </Directory>
  </Fragment>

  <!-- CNDL0005: Environment is only legal inside a Fragment, not under Product.
       The registry value is the KeyPath; ICE05 rejects a component with none. -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="PathEnvironment" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567893" Win64="yes">
        <Environment Id="AddToPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]\"
                     Action="set"
                     Part="last"
                     Permanent="no"
                     System="no" />
        <RegistryValue Root="HKLM" Key="Software\ObtainHub" Name="PathInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!-- CNDL0062 and CNDL0010 disagree: inside a ComponentGroup a Component must
       not carry @Directory, and outside one it must. Neither rule applies under
       a DirectoryRef, so both Components live here. Same shape the generated
       payload uses. -->
  <Fragment>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567891" Win64="yes">
        <File Id="ohub.exe" Source="dist\ohub\ohub.exe" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <!-- ICE38/ICE43/ICE57: a component under ProgramMenuFolder is per-user, so
         its KeyPath registry value must be HKCU, not HKLM. -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567892" Win64="yes">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="ObtainHub"
                  Target="[INSTALLFOLDER]ohub.exe" />
        <RemoveFolder Id="CleanupApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\ObtainHub" Name="ShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <!-- GENERATED PAYLOAD -->
</Wix>
