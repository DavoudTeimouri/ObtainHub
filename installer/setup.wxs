<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="ObtainHub"
           Language="1033"
           Version="3.0.3"
           Manufacturer="DavoudTeimouri"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="ObtainHub CLI installer"
             Manufacturer="DavoudTeimouri"
             Comments="ObtainHub v3.0.3"
             SummaryCodepage="1252" />

    <Icon Id="AppIcon" SourceFile="installer/icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of ObtainHub is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="ObtainHub" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="PathEnvironment" />
    </Feature>

    <!-- Guard against the EXE installer already being installed.
         The NSIS script writes its uninstall entry to Uninstall\{ProductGuid} with NO
         "_is1" suffix — NSIS only appends that when the app id is not already a GUID.
         The previous "_is1" key never existed, so this check could never fire. -->
    <Property Id="EXE_ALREADY_INSTALLED_64">
      <RegistrySearch Id="ExeUninstallEntrySearch64" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}"
                      Name="DisplayName" Type="raw" Win64="yes" />
    </Property>

    <Condition Message="ObtainHub is already installed by ObtainHub-Setup.exe. Uninstall it first, then run this installer. Both installers write to the same folder.">
      <![CDATA[Installed OR NOT EXE_ALREADY_INSTALLED_64]]>
    </Condition>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ObtainHub" />
      </Directory>
    </Directory>

    <!-- PATH environment variable management -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="PathEnvironment" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567893" Win64="yes">
        <Environment Id="AddToPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]\\"
                     Action="set"
                     Part="last"
                     Permanent="no"
                     System="no" />
        <RegistryValue Root="HKLM" Key="Software\ObtainHub" Name="PathInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="A1B2C3D4-E5F6-7890-ABCD-EF1234567891" Win64="yes">
        <File Id="ohub.exe" Source="target/release/ohub.exe" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Product>
</Wix>
